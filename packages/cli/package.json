{
  "name": "@dysonic/dy-cli",
  "version": "0.0.5",
  "description": "CLI entry package for dy-cli, mounting built-in commands and exposing the public command-line interface",
  "bin": {
    "dy-cli": "dist/cli.js"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm exec dy-cli build && pnpm run build:bin",
    "build:types": "pnpm exec dy-cli build --types",
    "build:bin": "pnpm exec dy-cli build --bin",
    "test": "pnpm exec dy-cli test",
    "test:coverage": "pnpm exec dy-cli test --coverage",
    "publish": "pnpm exec dy-cli publish",
    "publish:dry-run": "pnpm exec dy-cli publish --dry-run",
    "publish:beta": "pnpm exec dy-cli publish --tag beta",
    "publish:beta:dry-run": "pnpm exec dy-cli publish --tag beta --dry-run",
    "clean": "rimraf dist && rimraf coverage && rimraf node_modules",
    "prebuild": "rimraf dist"
  },
  "dependencies": {
    "@dysonic/dy-cli-core": "workspace:*",
    "@dysonic/dy-cli-cmd-add": "workspace:*",
    "@dysonic/dy-cli-cmd-build": "workspace:*",
    "@dysonic/dy-cli-cmd-create": "workspace:*",
    "@dysonic/dy-cli-cmd-publish": "workspace:*",
    "@dysonic/dy-cli-cmd-test": "workspace:*",
    "commander": "12.1.0"
  }
}
