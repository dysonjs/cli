{
  "name": "@dysonic/dy-cli-cmd-build",
  "version": "0.0.0",
  "description": "dy-cli 默认内置的构建命令，支持构建 CJS、ESM、UMD 和 CLI 等多种产物",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "ts-node-script ../../tools/scripts/build.ts --mode cjs",
    "build:esm": "ts-node-script ../../tools/scripts/build.ts --mode esm",
    "test": "ts-node-script ../../tools/scripts/test.ts --verbose --color",
    "test:coverage": "ts-node-script ../../tools/scripts/test.ts --coverage",
    "clean": "rimraf dist && rimraf coverage && rimraf node_modules",
    "prebuild": "rimraf dist"
  }
}
