  ".github/workflows/release.yml": "name: Release

on:
  workflow_dispatch:
    inputs:
      releaseType:
        description: Select the release bump to prepare
        required: true
        type: choice
        options:
          - patch
          - minor
          - major
      prerelease:
        description: Enter prerelease mode before versioning
        required: false
        type: boolean
        default: false

concurrency: \${{ github.workflow }}-\${{ github.ref_name }}

permissions:
  contents: write
  pull-requests: write

jobs:
  release-pr:
    name: Create Release Pull Request
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'pnpm'

      - name: Install Dependencies
        run: pnpm install

      - name: Prepare Release Changes
        shell: bash
        run: |
          args=\\"--\${{ inputs.releaseType }}\\"
          if [ \\"\${{ inputs.prerelease }}\\" = \\"true\\" ]; then
            args=\\"$args --beta\\"
          fi
          pnpm exec dy-cli version $args

      - name: Create Release Pull Request
        uses: peter-evans/create-pull-request@v6
        with:
          branch: release/\${{ inputs.releaseType }}
          commit-message: chore(release): prepare \${{ inputs.releaseType }} release
          title: Release: \${{ inputs.releaseType }}
          body: |
            This PR was prepared by the dy-cli release workflow.

            - Release type: \`\${{ inputs.releaseType }}\`
            - Prerelease mode: \`\${{ inputs.prerelease }}\`
",
  ".gitignore": ".idea
.vscode
.history
.DS_Store
.claude

# Dependency directories
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage directory used by tools like istanbul
coverage

!packages/*/test/__fixtures__/**
dist
tmp/
",
  ".husky/_/.gitignore": "*",
  ".husky/_/husky.sh": "#!/bin/sh
if [ -z \\"$husky_skip_init\\" ]; then
  debug () {
    if [ \\"$HUSKY_DEBUG\\" = \\"1\\" ]; then
      echo \\"husky (debug) - $1\\"
    fi
  }

  readonly hook_name=\\"$(basename \\"$0\\")\\"
  debug \\"starting $hook_name...\\"

  if [ \\"$HUSKY\\" = \\"0\\" ]; then
    debug \\"HUSKY env variable is set to 0, skipping hook\\"
    exit 0
  fi

  if [ -f ~/.huskyrc ]; then
    debug \\"sourcing ~/.huskyrc\\"
    . ~/.huskyrc
  fi

  export readonly husky_skip_init=1
  sh -e \\"$0\\" \\"$@\\"
  exitCode=\\"$?\\"

  if [ $exitCode != 0 ]; then
    echo \\"husky - $hook_name hook exited with code $exitCode (error)\\"
  fi

  exit $exitCode
fi
",
  ".husky/pre-commit": "#!/bin/sh
. \\"$(dirname \\"$0\\")/_/husky.sh\\"

npx lint-staged
",
  ".npmrc": "shamefully-hoist=true
//registry.npmjs.org/:_authToken=\${NPM_TOKEN}
",
  ".prettierignore": "__template__
dist
coverage
",
