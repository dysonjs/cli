{
  "name": "{{projectName}}",
  "private": false,
  "version": "0.0.0",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.umd.js",
  "files": [
    "dist"
  ],
  "packageManager": "{{packageManager}}",
  "scripts": {
    "build": "dy-cli build",
    "build:types": "dy-cli build --types",
    "build:umd": "dy-cli build --umd",
    "lint": "eslint src test dy.config.ts jest.config.js .eslintrc.js --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "test": "dy-cli test",
    "test:coverage": "dy-cli test --coverage",
    "release": "dy-cli build && dy-cli build --types && dy-cli build --umd && dy-cli publish",
    "release:dry-run": "dy-cli build && dy-cli build --types && dy-cli build --umd && dy-cli publish --dry-run",
    "release:beta": "dy-cli build && dy-cli build --types && dy-cli build --umd && dy-cli publish --tag beta",
    "release:beta:dry-run": "dy-cli build && dy-cli build --types && dy-cli build --umd && dy-cli publish --tag beta --dry-run",
    "version": "dy-cli version",
    "version:beta": "dy-cli version --beta",
    "version:beta:exit": "dy-cli version --beta-exit"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV=production eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "devDependencies": {
    "@types/jest": "~26.0.24",
    "@types/node": "~16.18.126",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "cross-env": "~7.0.3",
    "@dysonic/dy-cli": "{{cliVersion}}",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "husky": "~7.0.1",
    "jest": "~27.5.1",
    "lint-staged": "~11.2.6",
    "prettier": "~2.8.8",
    "ts-jest": "~27.1.5",
    "typescript": "~5.8.3"
  }
}
