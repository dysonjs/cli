{
  "name": "{{projectName}}",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "boot": "pnpm i",
    "add": "dy-cli add",
    "build": "dy-cli build --workspace",
    "build:types": "dy-cli build --workspace --types",
    "build:umd": "dy-cli build --workspace --umd",
    "clean": "pnpm -r --stream --workspace-concurrency 8 --parallel clean",
    "lint": "eslint '*/**/*.{js,ts,jsx,tsx}'",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "release": "dy-cli publish --workspace",
    "release:beta": "dy-cli publish --workspace --beta",
    "version": "dy-cli publish --version",
    "version:beta": "dy-cli publish --version --beta",
    "version:beta:exit": "dy-cli publish --version --beta-exit",
    "test": "dy-cli test --workspace",
    "test:coverage": "dy-cli test --workspace --coverage"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV='production' eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8",
    "pnpm": ">=10.8.0"
  },
  "devDependencies": {
    "@dysonic/dy-cli": "latest",
    "@dysonic/dy-cli-core": "latest",
    "@changesets/cli": "~2.28.1",
    "@rollup/plugin-commonjs": "~25.0.0",
    "@rollup/plugin-inject": "~5.0.3",
    "@rollup/plugin-json": "~6.1.0",
    "@rollup/plugin-node-resolve": "~15.3.0",
    "@rollup/plugin-replace": "~5.0.0",
    "@types/glob": "~8.1.0",
    "@types/jest": "~26.0.24",
    "@types/node": "~16.18.126",
    "@types/postcss-import": "~14.0.0",
    "@types/react": "^17.0.17",
    "@types/react-dom": "^17.0.9",
    "@types/resize-observer-browser": "~0.1.6",
    "@types/rollup-plugin-progress": "~1.1.1",
    "@types/svgo": "~2.6.3",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "autoprefixer": "~10.4.0",
    "chalk": "~4.1.2",
    "cpy-cli": "~3.1.1",
    "cross-env": "~7.0.3",
    "esbuild": "~0.17.19",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "eslint-plugin-react": "~7.37.5",
    "http-server": "~13.1.0",
    "husky": "~7.0.1",
    "jest": "~27.5.1",
    "jest-sinon": "~1.1.0",
    "less": "~4.1.3",
    "less-plugin-npm-import": "~2.1.0",
    "lint-staged": "~11.2.6",
    "postcss-import": "~14.1.0",
    "prettier": "~2.8.8",
    "rimraf": "~3.0.2",
    "ts-import-plugin": "~3.0.0",
    "ts-jest": "~27.1.5",
    "tslib": "~2.8.1",
    "typescript": "~5.8.3"
  },
  "browserslist": [
    "defaults"
  ],
  "resolutions": {
    "@types/react": "^17.0.17",
    "@types/react-dom": "^17.0.9"
  }
}
