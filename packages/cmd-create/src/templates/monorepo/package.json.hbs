{
  "name": "{{projectName}}",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "{{packageManager}}",
  "scripts": {
    "add": "dy-cli add",
    "build": "dy-cli build",
    "build:types": "dy-cli build --types",
    "build:umd": "dy-cli build --umd",
    "lint": "eslint '*/**/*.{js,ts,jsx,tsx}'",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "release": "dy-cli publish",
    "release:beta": "dy-cli publish --beta",
    "test": "dy-cli test",
    "test:coverage": "dy-cli test --coverage",
    "version": "dy-cli version",
    "version:beta": "dy-cli version --beta",
    "version:beta:exit": "dy-cli version --beta-exit"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV='production' eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "devDependencies": {
    "@types/jest": "~26.0.24",
    "@types/node": "~16.18.126",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "cross-env": "~7.0.3",
    "dy-cli": "npm:@dysonic/dy-cli@{{cliVersion}}",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "husky": "~7.0.1",
    "jest": "~27.5.1",
    "jest-sinon": "~1.1.0",
    "lint-staged": "~11.2.6",
    "prettier": "~2.8.8",
    "rimraf": "~3.0.2",
    "ts-jest": "~27.1.5",
    "typescript": "~5.8.3"
  },
  "browserslist": [
    "defaults"
  ]
}
