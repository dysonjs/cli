{
  "name": "dyson-cli",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dysonjs/cli.git"
  },
  "packageManager": "pnpm@10.8.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:package-files": "dy-cli publish --dry-run",
    "clean": "pnpm -r --stream --workspace-concurrency 8 --parallel clean",
    "lint": "eslint '*/**/*.{js,ts,jsx,tsx}'",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "test": "dy-cli test",
    "test:scaffold": "dy-cli test -- --runInBand packages/cmd-create/test/smoke.test.ts"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV='production' eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "devDependencies": {
    "@types/jest": "~26.0.24",
    "@types/node": "~16.18.126",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "cross-env": "~7.0.3",
    "dy-cli": "npm:@dysonic/dy-cli@1.0.5",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "husky": "~7.0.1",
    "jest": "~27.5.1",
    "jest-sinon": "~1.1.0",
    "lint-staged": "~11.2.6",
    "prettier": "~2.8.8",
    "rimraf": "~3.0.2",
    "ts-jest": "~27.1.5",
    "ts-node": "~10.2.0",
    "tsconfig-paths": "~4.2.0",
    "typescript": "~5.8.3"
  }
}
