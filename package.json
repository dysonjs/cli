{
  "name": "dyson-cli",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "boot": "pnpm i",
    "add": "pnpm exec dy-cli add",
    "build": "pnpm exec dy-cli build --workspace",
    "build:types": "pnpm exec dy-cli build --workspace --types",
    "clean": "pnpm -r --stream --workspace-concurrency 8 --parallel clean",
    "lint": "eslint '*/**/*.{js,ts,jsx,tsx}'",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "release": "pnpm exec dy-cli publish --workspace",
    "version": "pnpm exec dy-cli publish --version",
    "version:beta": "pnpm exec dy-cli publish --version --beta",
    "version:beta:exit": "pnpm exec dy-cli publish --version --beta-exit",
    "release:beta": "pnpm exec dy-cli publish --workspace --beta",
    "test": "pnpm exec dy-cli test --workspace",
    "test:coverage": "pnpm exec dy-cli test --workspace --coverage"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV='production' eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8",
    "pnpm": ">=10.8.0"
  },
  "devDependencies": {
    "dy-cli": "npm:@dysonic/dy-cli@0.0.5",
    "@changesets/cli": "~2.28.1",
    "@rollup/plugin-commonjs": "~25.0.0",
    "@rollup/plugin-inject": "~5.0.3",
    "@rollup/plugin-json": "~6.1.0",
    "@rollup/plugin-node-resolve": "~15.3.0",
    "@rollup/plugin-replace": "~5.0.0",
    "@types/fs-extra": "~9.0.12",
    "@types/inquirer": "~7.3.3",
    "@types/jest": "~26.0.24",
    "@types/lodash": "~4.17.16",
    "@types/node": "~16.18.126",
    "@types/resize-observer-browser": "~0.1.6",
    "@types/rollup-plugin-progress": "~1.1.1",
    "@types/svgo": "~2.6.3",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "autoprefixer": "~10.4.0",
    "commander": "~12.1.0",
    "cross-env": "~7.0.3",
    "esbuild": "~0.17.19",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "eslint-plugin-react": "~7.37.5",
    "husky": "~7.0.1",
    "jest": "~27.5.1",
    "jest-sinon": "~1.1.0",
    "lint-staged": "~11.2.6",
    "less-plugin-npm-import": "~2.1.0",
    "prettier": "~2.8.8",
    "rimraf": "~3.0.2",
    "rollup": "~4.40.0",
    "rollup-plugin-analyzer": "~4.0.0",
    "rollup-plugin-copy": "~3.5.0",
    "rollup-plugin-dts": "~6.2.1",
    "rollup-plugin-esbuild": "~6.2.1",
    "rollup-plugin-extensions": "~0.1.0",
    "rollup-plugin-polyfill-node": "~0.12.0",
    "rollup-plugin-progress": "~1.1.2",
    "rollup-plugin-serve": "~2.0.0",
    "rollup-plugin-typescript2": "~0.36.0",
    "ts-import-plugin": "~3.0.0",
    "ts-jest": "~27.1.5",
    "ts-node": "~10.2.0",
    "tsconfig-paths": "~4.2.0",
    "tslib": "~2.8.1",
    "typescript": "~5.8.3"
  }
}
