{
  "name": "dyson-cli",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "boot": "pnpm i",
    "build": "pnpm -r --stream --workspace-concurrency 8 build",
    "build:types": "pnpm -r --stream --workspace-concurrency 8 build:types",
    "clean": "pnpm -r --stream --workspace-concurrency 8 --parallel clean",
    "create": "ts-node-script tools/scripts/create.ts",
    "grant": "ts-node-script tools/scripts/grant.ts",
    "lint": "eslint '*/**/*.{js,ts,jsx,tsx}'",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "publish": "npm run build && npm run test && pnpm publish -r",
    "publish:dry-run": "npm run build && npm run test && pnpm publish -r --dry-run",
    "publish:beta": "npm run build && npm run test && pnpm publish -r --tag beta",
    "publish:beta:dry-run": "npm run build && npm run test && pnpm publish -r --tag beta --dry-run",
    "release": "pnpm run build && pnpm run test && pnpm changeset publish",
    "version": "pnpm changeset version",
    "version:beta": "pnpm changeset pre enter beta && pnpm changeset version",
    "version:beta:exit": "pnpm changeset pre exit",
    "release:beta": "pnpm run build && pnpm run test && pnpm changeset publish",
    "test": "cross-env NODE_ENV=test pnpm -r --workspace-concurrency 8 --stream test",
    "test:coverage": "pnpm -r --workspace-concurrency 8 --stream test:coverage"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "cross-env NODE_ENV='production' eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.20.8",
    "pnpm": ">=10.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "~2.28.1",
    "@rollup/plugin-commonjs": "~25.0.0",
    "@rollup/plugin-inject": "~5.0.3",
    "@rollup/plugin-json": "~6.1.0",
    "@rollup/plugin-node-resolve": "~15.3.0",
    "@rollup/plugin-replace": "~5.0.0",
    "@types/fs-extra": "~9.0.12",
    "@types/glob": "~8.1.0",
    "@types/inquirer": "~7.3.3",
    "@types/jest": "~26.0.24",
    "@types/lodash": "~4.17.16",
    "@types/metalsmith": "~2.6.0",
    "@types/node": "~16.18.126",
    "@types/resize-observer-browser": "~0.1.6",
    "@types/rollup-plugin-progress": "~1.1.1",
    "@types/svgo": "~2.6.3",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "autoprefixer": "~10.4.0",
    "chalk": "~4.1.2",
    "cpy-cli": "~3.1.1",
    "cross-env": "~7.0.3",
    "esbuild": "~0.17.19",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~3.4.0",
    "eslint-plugin-react": "~7.37.5",
    "execa": "~5.1.1",
    "fs-extra": "~10.1.0",
    "handlebars": "~4.7.7",
    "http-server": "~13.1.0",
    "husky": "~7.0.1",
    "inquirer": "~8.2.6",
    "jest": "~27.5.1",
    "jest-sinon": "~1.1.0",
    "lint-staged": "~11.2.6",
    "lodash": "~4.17.21",
    "metalsmith": "~2.6.0",
    "prettier": "~2.8.8",
    "rimraf": "~3.0.2",
    "rollup": "~4.40.0",
    "rollup-plugin-analyzer": "~4.0.0",
    "rollup-plugin-copy": "~3.5.0",
    "rollup-plugin-dts": "~6.2.1",
    "rollup-plugin-esbuild": "~6.2.1",
    "rollup-plugin-extensions": "~0.1.0",
    "rollup-plugin-polyfill-node": "~0.12.0",
    "rollup-plugin-progress": "~1.1.2",
    "rollup-plugin-serve": "~2.0.0",
    "rollup-plugin-typescript2": "~0.36.0",
    "ts-import-plugin": "~3.0.0",
    "ts-jest": "~27.1.5",
    "ts-node": "~10.2.0",
    "tslib": "~2.8.1",
    "typescript": "~5.8.3"
  }
}
